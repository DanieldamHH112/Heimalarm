# Kopieren nach .env (gleicher Ordner wie docker-compose.yml) und ausfüllen.
# .env wird nicht ins Repo übernommen.

# Zugang zur Zentrale (Mosquitto). Pflicht – ohne Passwort startet die Zentrale nicht.
# Dieselben Daten in der App (Einstellungen → Verbindung) und im ESP32 (secrets.yaml) eintragen.
MQTT_USER=heimalarm
MQTT_PASSWORD=bitte-aendern-langes-passwort

# Optional: Profile ohne Kommandozeile starten, z. B. zigbee oder zigbee,matter
# COMPOSE_PROFILES=zigbee
