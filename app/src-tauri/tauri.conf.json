{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heimalarm",
  "version": "../package.json",
  "identifier": "de.heimalarm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Heimalarm", "width": 1100, "height": 760, "minWidth": 360, "minHeight": 560 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "languages": ["German"], "installMode": "currentUser" } }
  }
}
